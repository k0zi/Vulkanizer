#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// Does this driver evaluate fma() with a single rounding? With a = 1 + 2^-12 and
// c = -(1 + 2^-11), a fused fma(a, a, c) is 2^-24; a multiply-then-add gives 0.
layout(local_size_x = 1) in;
layout(buffer_reference, std430, buffer_reference_align = 4) buffer Out { float v; };

// Device addresses arrive without their top bits (see vk/device.h); the hardware wants them
// canonical.
// The device's address bits 63..47 (vk::Device::addressHighBits), specialization constant 5.
layout(constant_id = 5) const uint kAddressHigh = 0xFFFF8000u;
uint64_t canon(uint64_t a) {  // on the high word alone
    uvec2 w = unpackUint2x32(a);
    w.y |= kAddressHigh;
    return packUint2x32(w);
}
layout(push_constant, std430) uniform Params {
    uint64_t out_;
    float a, c;
} p;

void main() {
    precise float r = fma(p.a, p.a, p.c);
    Out(canon(p.out_)).v = r;
}
