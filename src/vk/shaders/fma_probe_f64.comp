#version 460
#extension GL_EXT_buffer_reference : require

// fma_probe.comp for f64: with a = 1 + 2^-27 and c = -(1 + 2^-26), a fused fma(a, a, c)
// is 2^-54; a multiply-then-add gives 0.
layout(local_size_x = 1) in;
layout(buffer_reference, std430, buffer_reference_align = 8) buffer Out { double v; };
layout(push_constant, std430) uniform Params {
    Out out_;
    double a, c;
} p;

void main() {
    precise double r = fma(p.a, p.a, p.c);
    p.out_.v = r;
}
