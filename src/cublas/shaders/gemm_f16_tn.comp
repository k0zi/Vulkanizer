#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#ifdef F16_MATH
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#endif

// Fast path of gemm.comp for the shape transformers use: C = alpha * A^T * B + beta * C with
// f16 A and B, both contiguous along k (lda, ldb multiples of 8, 16-byte aligned), f32
// accumulation, C in f16 (C_F16 defined) or f32. Tiles of 128 x 128, 256 threads computing
// 8 x 8 outputs each; global loads are 16 bytes (8 halves along k).
// F16_MATH (CUBLAS_COMPUTE_16F on devices with f16 arithmetic): products and partial sums of
// 32 terms in packed f16, added into f32 accumulators -- twice the f32 rate where f16 math is
// packed, and still more accurate than the f16 accumulation compute 16F allows.

layout(local_size_x_id = 0, local_size_y_id = 1, local_size_z_id = 2) in;

layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer U16x8 { uvec4 v; };
layout(buffer_reference, std430, buffer_reference_align = 2) buffer U16 { uint16_t v; };
layout(buffer_reference, std430, buffer_reference_align = 4) buffer F32 { float v; };

// Device addresses arrive without their sign extension (bits 63..48, see vk/device.h); the
// hardware wants them canonical.
uint64_t canon(uint64_t a) {  // on the high word alone: one bit-field extract
    uvec2 w = unpackUint2x32(a);
    w.y = uint(bitfieldExtract(int(w.y), 0, 16));
    return packUint2x32(w);
}

layout(push_constant, std430) uniform Params {
    uint64_t a, b, c;
    int64_t strideA, strideB, strideC;  // elements between batch entries
    int m, n, k;
    int lda, ldb, ldc;
    float alpha, beta;
    uint flags;                         // unused here, layout shared with gemm.comp
    int batchOffset;
} p;

#ifdef F16_MATH
const int BM = 128, BN = 128, BK = 32, TM = 8, TN = 8;
shared float16_t As[BK][BM + 8];
shared f16vec2 Bs[BK][BN / 2 + 4];  // columns (2c, 2c + 1)
#else
const int BM = 128, BN = 128, BK = 16, TM = 8, TN = 8;
shared float As[BK][BM + 4];
shared float Bs[BK][BN + 4];
#endif

float loadHalf(uint64_t base, int64_t index) { return unpackHalf2x16(uint(U16(canon(base + uint64_t(index) * 2ul)).v)).x; }

// 8 consecutive halves along k of row `row` (of A^T or B^T), zero outside the matrix.
void loadRow8(uint64_t base, int ld, int row, int rows, int k, out float v[8]) {
    if (row < rows && k + 8 <= p.k) {
        const uvec4 w = U16x8(canon(base + (uint64_t(row) * uint64_t(ld) + uint64_t(k)) * 2ul)).v;
        for (int q = 0; q < 4; ++q) {
            const vec2 h = unpackHalf2x16(w[q]);
            v[2 * q] = h.x;
            v[2 * q + 1] = h.y;
        }
    } else {
        for (int q = 0; q < 8; ++q)
            v[q] = row < rows && k + q < p.k ? loadHalf(base, int64_t(row) * ld + k + q) : 0.0;
    }
}

uint toHalfBits(float f) {  // round to nearest even (packHalf2x16 rounding is implementation-defined)
    const uint u = floatBitsToUint(f), sign = (u >> 16) & 0x8000u, a = u & 0x7FFFFFFFu;
    if (a > 0x7F800000u) return sign | 0x7E00u;
    if (a >= 0x477FF000u) return sign | 0x7C00u;
    uint h;
    if (a < 0x38800000u) {
        const uint e = a >> 23;
        if (e < 102u) return sign;
        const uint mant = (a & 0x7FFFFFu) | 0x800000u, s = 126u - e;
        h = mant >> s;
        const uint rem = mant & ((1u << s) - 1u), half_ = 1u << (s - 1u);
        if (rem > half_ || (rem == half_ && (h & 1u) != 0u)) ++h;
    } else {
        const uint x = a - (112u << 23);
        h = x >> 13;
        const uint rem = x & 0x1FFFu;
        if (rem > 0x1000u || (rem == 0x1000u && (h & 1u) != 0u)) ++h;
    }
    return sign | h;
}

uint64_t batchBase(uint64_t base, int64_t stride, int batch, uint64_t size) {
    return base + uint64_t(stride * batch) * size;
}

void store(uint64_t C, int gm, int gn, float acc) {
    if (gm >= p.m || gn >= p.n) return;
    const int64_t idx = int64_t(gm) + int64_t(gn) * p.ldc;
    float v = p.alpha * acc;
#ifdef C_F16
    if (p.beta != 0.0) v += p.beta * loadHalf(C, idx);
    U16(canon(C + uint64_t(idx) * 2ul)).v = uint16_t(toHalfBits(v));
#else
    if (p.beta != 0.0) v += p.beta * F32(canon(C + uint64_t(idx) * 4ul)).v;
    F32(canon(C + uint64_t(idx) * 4ul)).v = v;
#endif
}

#ifdef F16_MATH
// 8 raw halves along k (2 per uint), zero outside the matrix.
uvec4 loadRaw8(uint64_t base, int ld, int row, int rows, int k) {
    if (row < rows && k + 8 <= p.k) return U16x8(canon(base + (uint64_t(row) * uint64_t(ld) + uint64_t(k)) * 2ul)).v;
    uint h[8];
    for (int q = 0; q < 8; ++q)
        h[q] = row < rows && k + q < p.k ? uint(U16(canon(base + (uint64_t(row) * uint64_t(ld) + uint64_t(k + q)) * 2ul)).v) : 0u;
    return uvec4(h[0] | h[1] << 16, h[2] | h[3] << 16, h[4] | h[5] << 16, h[6] | h[7] << 16);
}

void main() {
    const int batch = int(gl_WorkGroupID.z) + p.batchOffset;
    const uint64_t A = batchBase(p.a, p.strideA, batch, 2ul), B = batchBase(p.b, p.strideB, batch, 2ul);
#ifdef C_F16
    const uint64_t C = batchBase(p.c, p.strideC, batch, 2ul);
#else
    const uint64_t C = batchBase(p.c, p.strideC, batch, 4ul);
#endif
    const int tileM = int(gl_WorkGroupID.x) * BM, tileN = int(gl_WorkGroupID.y) * BN;
    const int tx = int(gl_LocalInvocationID.x), ty = int(gl_LocalInvocationID.y);
    const int tid = ty * 16 + tx;
    // A loader: 2 threads per row, 16 halves each. B loader: 4 threads per row pair, 8 each.
    const int arow = tid >> 1, ak = (tid & 1) * 16;
    const int bpair = tid >> 2, bk = (tid & 3) * 8;

    float acc[TM][TN];
    for (int i = 0; i < TM; ++i)
        for (int j = 0; j < TN; ++j) acc[i][j] = 0.0;

    for (int k0 = 0; k0 < p.k; k0 += BK) {
        const uvec4 a0 = loadRaw8(A, p.lda, tileM + arow, p.m, k0 + ak);
        const uvec4 a1 = loadRaw8(A, p.lda, tileM + arow, p.m, k0 + ak + 8);
        const uvec4 b0 = loadRaw8(B, p.ldb, tileN + 2 * bpair, p.n, k0 + bk);
        const uvec4 b1 = loadRaw8(B, p.ldb, tileN + 2 * bpair + 1, p.n, k0 + bk);
        for (int q = 0; q < 4; ++q) {
            const f16vec2 x0 = unpackFloat2x16(a0[q]), x1 = unpackFloat2x16(a1[q]);
            As[ak + 2 * q][arow] = x0.x;
            As[ak + 2 * q + 1][arow] = x0.y;
            As[ak + 8 + 2 * q][arow] = x1.x;
            As[ak + 8 + 2 * q + 1][arow] = x1.y;
            const f16vec2 r0 = unpackFloat2x16(b0[q]), r1 = unpackFloat2x16(b1[q]);
            Bs[bk + 2 * q][bpair] = f16vec2(r0.x, r1.x);
            Bs[bk + 2 * q + 1][bpair] = f16vec2(r0.y, r1.y);
        }
        barrier();
        f16vec2 part[TM][TN / 2];
        for (int i = 0; i < TM; ++i)
            for (int j = 0; j < TN / 2; ++j) part[i][j] = f16vec2(0.0hf);
        for (int kk = 0; kk < BK; ++kk) {
            float16_t a[TM];
            f16vec2 b[TN / 2];
            for (int i = 0; i < TM; ++i) a[i] = As[kk][ty + 16 * i];
            for (int j = 0; j < TN / 2; ++j) b[j] = Bs[kk][tx + 16 * j];
            for (int i = 0; i < TM; ++i)
                for (int j = 0; j < TN / 2; ++j) part[i][j] = fma(f16vec2(a[i]), b[j], part[i][j]);
        }
        for (int i = 0; i < TM; ++i)
            for (int j = 0; j < TN / 2; ++j) {
                const vec2 v = vec2(part[i][j]);
                acc[i][2 * j] += v.x;
                acc[i][2 * j + 1] += v.y;
            }
        barrier();
    }

    // thread (tx, ty) owns rows ty + 16 i and column pairs tx + 16 j
    for (int j = 0; j < TN / 2; ++j)
        for (int i = 0; i < TM; ++i) {
            const int gm = tileM + ty + 16 * i, gn = tileN + 2 * (tx + 16 * j);
            store(C, gm, gn, acc[i][2 * j]);
            store(C, gm, gn + 1, acc[i][2 * j + 1]);
        }
}
#else
void main() {
    const int batch = int(gl_WorkGroupID.z) + p.batchOffset;
    const uint64_t A = batchBase(p.a, p.strideA, batch, 2ul), B = batchBase(p.b, p.strideB, batch, 2ul);
#ifdef C_F16
    const uint64_t C = batchBase(p.c, p.strideC, batch, 2ul);
#else
    const uint64_t C = batchBase(p.c, p.strideC, batch, 4ul);
#endif
    const int tileM = int(gl_WorkGroupID.x) * BM, tileN = int(gl_WorkGroupID.y) * BN;
    const int tx = int(gl_LocalInvocationID.x), ty = int(gl_LocalInvocationID.y);
    const int tid = ty * 16 + tx;
    // loader mapping: 2 threads per row, 8 halves each
    const int lrow = tid >> 1, lk = (tid & 1) * 8;

    float acc[TM][TN];
    for (int i = 0; i < TM; ++i)
        for (int j = 0; j < TN; ++j) acc[i][j] = 0.0;

    for (int k0 = 0; k0 < p.k; k0 += BK) {
        float va[8], vb[8];
        loadRow8(A, p.lda, tileM + lrow, p.m, k0 + lk, va);
        loadRow8(B, p.ldb, tileN + lrow, p.n, k0 + lk, vb);
        for (int q = 0; q < 8; ++q) {
            As[lk + q][lrow] = va[q];
            Bs[lk + q][lrow] = vb[q];
        }
        barrier();
        for (int kk = 0; kk < BK; ++kk) {
            float a[TM], b[TN];
            for (int i = 0; i < TM; ++i) a[i] = As[kk][ty + 16 * i];
            for (int j = 0; j < TN; ++j) b[j] = Bs[kk][tx + 16 * j];
            for (int i = 0; i < TM; ++i)
                for (int j = 0; j < TN; ++j) acc[i][j] += a[i] * b[j];
        }
        barrier();
    }

    // thread (tx, ty) owns rows ty + 16 i and columns tx + 16 j
    for (int j = 0; j < TN; ++j)
        for (int i = 0; i < TM; ++i) store(C, tileM + ty + 16 * i, tileN + tx + 16 * j, acc[i][j]);
}
#endif
