#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// A copy of `rows` lines of `vecs` x 16 bytes from one pitch to another (gemm_coopmat operands whose
// rows lie a multiple of 4 KiB apart, see repitch in cublas.cpp). One uvec4 per thread: x along a
// line, y over lines.

layout(local_size_x = 64, local_size_y = 4) in;

layout(buffer_reference, std430, buffer_reference_align = 16) buffer V4 { uvec4 v; };

// The device's address bits 63..47 (vk::Device::addressHighBits), specialization constant 5.
layout(constant_id = 5) const uint kAddressHigh = 0xFFFF8000u;
uint64_t canon(uint64_t a) {  // on the high word alone
    uvec2 w = unpackUint2x32(a);
    w.y |= kAddressHigh;
    return packUint2x32(w);
}

layout(push_constant, std430) uniform Params {
    uint64_t src, dst;
    uint64_t srcPitch, dstPitch;  // bytes
    int vecs, rows;
} p;

void main() {
    const int x = int(gl_GlobalInvocationID.x), y = int(gl_GlobalInvocationID.y);
    if (x >= p.vecs || y >= p.rows) return;
    V4(canon(p.dst + uint64_t(y) * p.dstPitch + uint64_t(x) * 16ul)).v =
        V4(canon(p.src + uint64_t(y) * p.srcPitch + uint64_t(x) * 16ul)).v;
}
