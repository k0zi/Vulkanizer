#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// Batched triangular solve, f32 (cublasStrsmBatched), in place on B:
//   side left:  op(A) X = alpha B   (A is m x m, B is m x n)
//   side right: X op(A) = alpha B   (A is n x n, B is m x n)
// Every thread solves one independent right-hand side (a column of B for side left, a row for
// side right) by forward or backward substitution. Workgroup z selects the batch entry.

layout(local_size_x_id = 0, local_size_y_id = 1, local_size_z_id = 2) in;

layout(buffer_reference, std430, buffer_reference_align = 4) buffer F32 { float v; };
layout(buffer_reference, std430, buffer_reference_align = 8) readonly buffer Ptr { uint64_t v; };

// Device addresses arrive without their top bits (see vk/device.h); the hardware wants them
// canonical.
uint64_t canon(uint64_t a) {  // on the high word alone: bits 63..47 set (vk::kHostAddressBits)
    uvec2 w = unpackUint2x32(a);
    w.y |= 0xFFFF8000u;
    return packUint2x32(w);
}

layout(push_constant, std430) uniform Params {
    uint64_t a, b;   // device arrays of matrix pointers
    int m, n;        // B is m x n
    int lda, ldb;
    float alpha;
    uint flags;      // kLeft | kLower | kTrans | kUnit
    int batchOffset;
} p;

const uint kLeft = 1u, kLower = 2u, kTrans = 4u, kUnit = 8u;

void main() {
    const bool left = (p.flags & kLeft) != 0u, trans = (p.flags & kTrans) != 0u, unit = (p.flags & kUnit) != 0u;
    const int size = left ? p.m : p.n;    // order of the system
    const int rhs = int(gl_GlobalInvocationID.x);
    if (rhs >= (left ? p.n : p.m)) return;
    const int batch = int(gl_WorkGroupID.z) + p.batchOffset;
    const uint64_t A = Ptr(canon(p.a + uint64_t(batch) * 8ul)).v, B = Ptr(canon(p.b + uint64_t(batch) * 8ul)).v;

    // op(A) is lower triangular when exactly one of "stored lower" and "transposed" holds; for
    // side right the system matrix is op(A) transposed.
    const bool opLower = ((p.flags & kLower) != 0u) != trans;
    const bool lowerSystem = left ? opLower : !opLower;

    for (int step = 0; step < size; ++step) {
        const int i = lowerSystem ? step : size - 1 - step;
        const int64_t bi = left ? int64_t(i) + int64_t(rhs) * p.ldb : int64_t(rhs) + int64_t(i) * p.ldb;
        float x = p.alpha * F32(canon(B + uint64_t(bi) * 4ul)).v;
        for (int s = 0; s < step; ++s) {
            const int k = lowerSystem ? s : size - 1 - s;
            // system matrix S[i][k]: op(A)[i][k] for side left, op(A)[k][i] for side right
            const int r = left ? i : k, c = left ? k : i;  // element of op(A)
            const int64_t ai = trans ? int64_t(c) + int64_t(r) * p.lda : int64_t(r) + int64_t(c) * p.lda;
            const int64_t bk = left ? int64_t(k) + int64_t(rhs) * p.ldb : int64_t(rhs) + int64_t(k) * p.ldb;
            x -= F32(canon(A + uint64_t(ai) * 4ul)).v * F32(canon(B + uint64_t(bk) * 4ul)).v;
        }
        if (!unit) x /= F32(canon(A + uint64_t(int64_t(i) + int64_t(i) * p.lda) * 4ul)).v;
        F32(canon(B + uint64_t(bi) * 4ul)).v = x;
    }
}
