#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require

// gemm_f16_tn.comp on cooperative matrices (VK_KHR_cooperative_matrix: the GPU's matrix units where
// it has them): C = alpha * A^T * B + beta * C with f16 A and B, both contiguous along k (lda, ldb
// multiples of 8, 16-byte aligned), f32 accumulation, C in f16 (C_F16 defined) or f32.
// S x S x S matrices (S = 16, or 8 on llvmpipe). A workgroup is 4 subgroups side by side in 2 x 2,
// each computing 4 x 4 output matrices: tiles of 8S x 8S (128 x 128; SMALL_TILE: 2 x 2 matrices, 64 x 64,
// for products with fewer tiles than the GPU has compute units), k in steps of 2S through shared
// memory. The next step's operands are loaded into registers while the current one is multiplied.
// The results leave one matrix at a time through a small shared buffer per subgroup (edges, alpha,
// beta, exact f16 rounding).
// Compiled for Vulkan 1.2 (SPIR-V 1.5), so the subgroup size is the device's: the launch's
// 4 * subgroup size threads are exactly 4 subgroups.

layout(local_size_x_id = 0, local_size_y_id = 1, local_size_z_id = 2) in;

layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer U16x8 { uvec4 v; };
layout(buffer_reference, std430, buffer_reference_align = 2) buffer U16 { uint16_t v; };
layout(buffer_reference, std430, buffer_reference_align = 4) buffer F32 { float v; };

// The device's address bits 63..47 (vk::Device::addressHighBits), specialization constant 5.
layout(constant_id = 5) const uint kAddressHigh = 0xFFFF8000u;
uint64_t canon(uint64_t a) {  // on the high word alone
    uvec2 w = unpackUint2x32(a);
    w.y |= kAddressHigh;
    return packUint2x32(w);
}

layout(push_constant, std430) uniform Params {
    uint64_t a, b, c;
    int64_t strideA, strideB, strideC;  // elements between batch entries
    int m, n, k;
    int lda, ldb, ldc;
    float alpha, beta;
    uint flags;                         // unused here, layout shared with gemm.comp
    int batchOffset;
} p;

#ifdef SMALL_TILE
const int TM = 2, TN = 2;                // output matrices per subgroup: tiles of 4S x 4S, for small products
#else
const int TM = 4, TN = 4;                // output matrices per subgroup
#endif
const int BM = 2 * TM * S, BN = 2 * TN * S, BK = 2 * S;
const int LDV = BK / 8 + 1;              // row pitch in uvec4 (8 halves): rows on different banks
shared uvec4 As[BM * LDV];               // row i of A^T, along k
shared uvec4 Bs[BN * LDV];               // column j of B, along k
shared float Cs[4][S * S];               // per subgroup: one result matrix on its way out

float loadHalf(uint64_t base, int64_t index) { return unpackHalf2x16(uint(U16(canon(base + uint64_t(index) * 2ul)).v)).x; }

// 8 raw halves along k (2 per uint) of row `row` (of A^T or B^T), zero outside the matrix.
uvec4 loadRaw8(uint64_t base, int ld, int row, int rows, int k) {
    if (row < rows && k + 8 <= p.k) return U16x8(canon(base + (uint64_t(row) * uint64_t(ld) + uint64_t(k)) * 2ul)).v;
    uint h[8];
    for (int q = 0; q < 8; ++q)
        h[q] = row < rows && k + q < p.k ? uint(U16(canon(base + (uint64_t(row) * uint64_t(ld) + uint64_t(k + q)) * 2ul)).v) : 0u;
    return uvec4(h[0] | h[1] << 16, h[2] | h[3] << 16, h[4] | h[5] << 16, h[6] | h[7] << 16);
}

uint toHalfBits(float f) {  // round to nearest even (packHalf2x16 rounding is implementation-defined)
    const uint u = floatBitsToUint(f), sign = (u >> 16) & 0x8000u, a = u & 0x7FFFFFFFu;
    if (a > 0x7F800000u) return sign | 0x7E00u;
    if (a >= 0x477FF000u) return sign | 0x7C00u;
    uint h;
    if (a < 0x38800000u) {
        const uint e = a >> 23;
        if (e < 102u) return sign;
        const uint mant = (a & 0x7FFFFFu) | 0x800000u, s = 126u - e;
        h = mant >> s;
        const uint rem = mant & ((1u << s) - 1u), half_ = 1u << (s - 1u);
        if (rem > half_ || (rem == half_ && (h & 1u) != 0u)) ++h;
    } else {
        const uint x = a - (112u << 23);
        h = x >> 13;
        const uint rem = x & 0x1FFFu;
        if (rem > 0x1000u || (rem == 0x1000u && (h & 1u) != 0u)) ++h;
    }
    return sign | h;
}

uint64_t batchBase(uint64_t base, int64_t stride, int batch, uint64_t size) {
    return base + uint64_t(stride * batch) * size;
}

void store(uint64_t C, int gm, int gn, float acc) {
    if (gm >= p.m || gn >= p.n) return;
    const int64_t idx = int64_t(gm) + int64_t(gn) * p.ldc;
    float v = p.alpha * acc;
#ifdef C_F16
    if (p.beta != 0.0) v += p.beta * loadHalf(C, idx);
    U16(canon(C + uint64_t(idx) * 2ul)).v = uint16_t(toHalfBits(v));
#else
    if (p.beta != 0.0) v += p.beta * F32(canon(C + uint64_t(idx) * 4ul)).v;
    F32(canon(C + uint64_t(idx) * 4ul)).v = v;
#endif
}

const int kLoads = BM * BK / 8;  // uvec4 loads of one operand per k step (BM == BN)

void main() {
    const int batch = int(gl_WorkGroupID.z) + p.batchOffset;
    const uint64_t A = batchBase(p.a, p.strideA, batch, 2ul), B = batchBase(p.b, p.strideB, batch, 2ul);
#ifdef C_F16
    const uint64_t C = batchBase(p.c, p.strideC, batch, 2ul);
#else
    const uint64_t C = batchBase(p.c, p.strideC, batch, 4ul);
#endif
    const int tileM = int(gl_WorkGroupID.x) * BM, tileN = int(gl_WorkGroupID.y) * BN;
    const int tid = int(gl_LocalInvocationIndex);
    const int threads = int(gl_WorkGroupSize.x * gl_WorkGroupSize.y * gl_WorkGroupSize.z);
    const int perThread = (kLoads + threads - 1) / threads;  // 2 with 256 threads
    // this subgroup's TM S x TN S part of the tile
    const int sg = int(gl_SubgroupID);
    const int sm = (sg & 1) * TM * S, sn = (sg >> 1) * TN * S;

    coopmat<float, gl_ScopeSubgroup, S, S, gl_MatrixUseAccumulator> acc[TM][TN];
    for (int i = 0; i < TM; ++i)
        for (int j = 0; j < TN; ++j) acc[i][j] = coopmat<float, gl_ScopeSubgroup, S, S, gl_MatrixUseAccumulator>(0.0);

    uvec4 ra[4], rb[4];  // the next k step (perThread <= 4: at least kLoads / 4 threads)
    for (int r = 0; r < perThread; ++r) {
        const int idx = tid + r * threads;
        if (idx < kLoads) {
            const int row = idx / (BK / 8), k = idx % (BK / 8) * 8;
            ra[r] = loadRaw8(A, p.lda, tileM + row, p.m, k);
            rb[r] = loadRaw8(B, p.ldb, tileN + row, p.n, k);
        }
    }
    for (int k0 = 0; k0 < p.k; k0 += BK) {
        barrier();  // the previous step's multiplications are done with the shared tiles
        for (int r = 0; r < perThread; ++r) {
            const int idx = tid + r * threads;
            if (idx < kLoads) {
                const int row = idx / (BK / 8), kv = idx % (BK / 8);
                As[row * LDV + kv] = ra[r];
                Bs[row * LDV + kv] = rb[r];
            }
        }
        barrier();
        if (k0 + BK < p.k) {  // the next step, in flight during the multiplications
            for (int r = 0; r < perThread; ++r) {
                const int idx = tid + r * threads;
                if (idx < kLoads) {
                    const int row = idx / (BK / 8), k = k0 + BK + idx % (BK / 8) * 8;
                    ra[r] = loadRaw8(A, p.lda, tileM + row, p.m, k);
                    rb[r] = loadRaw8(B, p.ldb, tileN + row, p.n, k);
                }
            }
        }
        for (int kk = 0; kk < BK; kk += S) {
            coopmat<float16_t, gl_ScopeSubgroup, S, S, gl_MatrixUseA> a[TM];
            coopmat<float16_t, gl_ScopeSubgroup, S, S, gl_MatrixUseB> b[TN];
            // offsets and strides in uvec4 units (8 halves); kk is a multiple of 8
            for (int i = 0; i < TM; ++i)
                coopMatLoad(a[i], As, (sm + i * S) * LDV + kk / 8, LDV, gl_CooperativeMatrixLayoutRowMajor);
            for (int j = 0; j < TN; ++j)  // B (k x n) column j is a row of Bs
                coopMatLoad(b[j], Bs, (sn + j * S) * LDV + kk / 8, LDV, gl_CooperativeMatrixLayoutColumnMajor);
            for (int i = 0; i < TM; ++i)
                for (int j = 0; j < TN; ++j) acc[i][j] = coopMatMulAdd(a[i], b[j], acc[i][j]);
        }
    }

    // Out one matrix at a time through this subgroup's part of Cs, column major.
    const int lane = int(gl_SubgroupInvocationID), lanes = int(gl_SubgroupSize);
    for (int i = 0; i < TM; ++i)
        for (int j = 0; j < TN; ++j) {
            const int gm = tileM + sm + i * S, gn = tileN + sn + j * S;
            if (gm >= p.m || gn >= p.n) continue;  // uniform in the subgroup
            coopMatStore(acc[i][j], Cs[sg], 0, S, gl_CooperativeMatrixLayoutColumnMajor);
            subgroupMemoryBarrierShared();
            subgroupBarrier();
            for (int e = lane; e < S * S; e += lanes) store(C, gm + e % S, gn + e / S, Cs[sg][e]);
            subgroupMemoryBarrierShared();
            subgroupBarrier();
        }
}
