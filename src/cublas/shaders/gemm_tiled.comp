#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_control_flow_attributes : require

// gemm.comp for larger matrices: the same parameters, f32 accumulation in k order, faster. Tiles of 128 x 128 with k steps of 16; 256 threads computing 8 x 8 outputs
// each: rows 4 tx + {0..3} and 64 + 4 tx + {0..3}, columns likewise by ty, read from the tile in
// shared memory as 16-byte vectors. Every thread loads 8 consecutive elements of A and of B
// along whichever dimension is contiguous in memory, as two (f32) or one (f16/bf16) 16-byte load
// where the layout allows (kConfig); the next k step's loads are issued before the current
// step's products (register prefetch), and nothing reads them until they go to shared memory.

layout(local_size_x_id = 0, local_size_y_id = 1, local_size_z_id = 2) in;

layout(buffer_reference, std430, buffer_reference_align = 4) buffer F32 { float v; };
layout(buffer_reference, std430, buffer_reference_align = 2) buffer U16 { uint16_t v; };
layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer V4 { uvec4 v; };
layout(buffer_reference, std430, buffer_reference_align = 8) readonly buffer Ptr { uint64_t v; };

// The device's address bits 63..47 (vk::Device::addressHighBits), specialization constant 5:
// addresses arrive without them.
layout(constant_id = 5) const uint kAddressHigh = 0xFFFF8000u;
uint64_t canon(uint64_t a) {
    uvec2 w = unpackUint2x32(a);
    w.y |= kAddressHigh;
    return packUint2x32(w);
}

layout(push_constant, std430) uniform Params {
    uint64_t a, b, c;
    int64_t strideA, strideB, strideC;
    int m, n, k;
    int lda, ldb, ldc;
    float alpha, beta;
    uint flags;
    int batchOffset;
} p;

const uint kPointerArrays = 0x10000u;
const uint kF32 = 0u, kF16 = 1u, kBF16 = 2u;
uint typeC() { return (p.flags >> 12) & 15u; }
uint64_t elemSize(uint t) { return t == kF32 ? 4ul : 2ul; }

// The operands' layout, fixed per pipeline (cublas.cpp writes it into the SPIR-V): whether each
// is contiguous along k, its type, and whether its runs of 8 are loaded as 16-byte vectors (all
// row starts 16-byte aligned and the contiguous dimension a multiple of 8, so a run lies wholly
// inside or outside the matrix). Branches on these vanish, so the loads have none: elements
// outside the matrix read the matrix's first element and are zeroed when stored to shared memory.
layout(constant_id = 10) const uint kConfig = 0u;
const bool kAlongKA = (kConfig & 1u) != 0u, kAlongKB = (kConfig & 2u) != 0u;
const uint kTypeA = (kConfig >> 2) & 3u, kTypeB = (kConfig >> 4) & 3u;
const bool kVecA = (kConfig & 64u) != 0u, kVecB = (kConfig & 128u) != 0u;

float fromBits(uint bits, uint type) { return type == kBF16 ? uintBitsToFloat(bits << 16) : unpackHalf2x16(bits).x; }

float load1(uint64_t at, uint type) {
    if (type == kF32) return F32(canon(at)).v;
    return fromBits(uint(U16(canon(at)).v), type);
}

uint roundToBits(float f, bool brain) {
    const uint u = floatBitsToUint(f);
    if (brain) return isnan(f) ? 0x7FC0u : (u + 0x7FFFu + ((u >> 16) & 1u)) >> 16;
    const uint sign = (u >> 16) & 0x8000u, a = u & 0x7FFFFFFFu;  // f32 -> f16, round to nearest even
    if (a > 0x7F800000u) return sign | 0x7E00u;
    if (a >= 0x477FF000u) return sign | 0x7C00u;
    uint h;
    if (a < 0x38800000u) {
        const uint e = a >> 23;
        if (e < 102u) return sign;
        const uint mant = (a & 0x7FFFFFu) | 0x800000u, s = 126u - e;
        h = mant >> s;
        const uint rem = mant & ((1u << s) - 1u), half_ = 1u << (s - 1u);
        if (rem > half_ || (rem == half_ && (h & 1u) != 0u)) ++h;
    } else {
        const uint x = a - (112u << 23);
        h = x >> 13;
        const uint rem = x & 0x1FFFu;
        if (rem > 0x1000u || (rem == 0x1000u && (h & 1u) != 0u)) ++h;
    }
    return sign | h;
}

const int BM = 128, BN = 128, BK = 16, TM = 8, TN = 8;
// as vec4s, so a thread reads its 4 consecutive rows (columns) in one 16-byte access
shared vec4 As[BK][BM / 4 + 1];
shared vec4 Bs[BK][BN / 4 + 1];

// One operand's loader: the thread's run of 8 (along the contiguous dimension) and its position.
struct Loader {
    uint64_t base;     // the matrix (what loads outside it read)
    uint64_t at;       // the run's address at the current k step
    uint64_t step;     // bytes to the next k step
    int c, limit;      // the run's start and length of the contiguous dimension
    int other;         // index along the other dimension (row of the run, or k)
    bool inside;       // `other` within the matrix (rows; k is checked per step)
};

// Operand X (rows x k; element (r, kk) at kk + r * ld if alongK, else r + kk * ld).
Loader loader(uint64_t base, bool alongK, int tileStart, int rows, int ld, uint type, int tid) {
    Loader l;
    l.base = base;
    if (alongK) {  // 2 threads per row, 8 k each
        l.other = tileStart + (tid >> 1);
        l.c = (tid & 1) * 8;
        l.limit = p.k;
        l.inside = l.other < rows;
        l.step = uint64_t(BK) * elemSize(type);
    } else {  // 16 threads per k, 8 rows each
        l.other = tid >> 4;
        l.c = tileStart + (tid & 15) * 8;
        l.limit = rows;
        l.inside = true;
        l.step = uint64_t(BK) * uint64_t(ld) * elemSize(type);
    }
    l.at = base + (uint64_t(l.other) * uint64_t(ld) + uint64_t(l.c)) * elemSize(type);
    return l;
}

// The raw words of the run at step k0 (f32 bits, or 16-bit values: packed in pairs when vector
// loaded, one per word otherwise) and which of its 8 elements exist.
void fetch(Loader l, bool alongK, uint type, bool vec, int k0, out uint w[8], out uint valid) {
    const int c = alongK ? k0 + l.c : l.c;
    const bool row = alongK ? l.inside : k0 + l.other < p.k;
    if (vec) {
        const bool ok = row && c < l.limit;
        const uint64_t at = ok ? l.at : l.base;
        const uvec4 lo = V4(canon(at)).v;
        const uvec4 hi = type == kF32 ? V4(canon(at + 16ul)).v : uvec4(0u);
        for (int q = 0; q < 4; ++q) {
            w[q] = lo[q];
            w[q + 4] = hi[q];
        }
        valid = ok ? 0xFFu : 0u;
        return;
    }
    valid = 0u;
    const uint64_t size = elemSize(type);
    for (int q = 0; q < 8; ++q) {
        const bool ok = row && c + q < l.limit;
        const uint64_t at = ok ? l.at + uint64_t(q) * size : l.base;
        w[q] = type == kF32 ? floatBitsToUint(F32(canon(at)).v) : uint(U16(canon(at)).v);
        valid |= ok ? 1u << q : 0u;
    }
}

float element(uint w[8], uint valid, int q, uint type, bool vec) {
    if ((valid & (1u << q)) == 0u) return 0.0;
    if (type == kF32) return uintBitsToFloat(w[q]);
    return fromBits(vec ? (w[q >> 1] >> (16 * (q & 1))) & 0xFFFFu : w[q], type);
}

void put(bool a, int kk, int i, float v) {
    if (a) As[kk][i >> 2][i & 3] = v;
    else Bs[kk][i >> 2][i & 3] = v;
}

// The run into the tile: 8 k of one row, or 8 rows of one k.
void stage(bool a, Loader l, bool alongK, uint type, bool vec, int tileStart, uint w[8], uint valid) {
    float v[8];
    for (int q = 0; q < 8; ++q) v[q] = element(w, valid, q, type, vec);
    if (alongK) {
        for (int q = 0; q < 8; ++q) put(a, l.c + q, l.other - tileStart, v[q]);
    } else {
        const int at = (l.c - tileStart) >> 2;
        if (a) {
            As[l.other][at] = vec4(v[0], v[1], v[2], v[3]);
            As[l.other][at + 1] = vec4(v[4], v[5], v[6], v[7]);
        } else {
            Bs[l.other][at] = vec4(v[0], v[1], v[2], v[3]);
            Bs[l.other][at + 1] = vec4(v[4], v[5], v[6], v[7]);
        }
    }
}

void main() {
    const int batch = int(gl_WorkGroupID.z) + p.batchOffset;
    uint64_t A = p.a, B = p.b, C = p.c;
    if ((p.flags & kPointerArrays) != 0u) {
        A = Ptr(canon(p.a + uint64_t(batch) * 8ul)).v;
        B = Ptr(canon(p.b + uint64_t(batch) * 8ul)).v;
        C = Ptr(canon(p.c + uint64_t(batch) * 8ul)).v;
    } else {
        A += uint64_t(p.strideA * batch) * elemSize(kTypeA);
        B += uint64_t(p.strideB * batch) * elemSize(kTypeB);
        C += uint64_t(p.strideC * batch) * elemSize(typeC());
    }
    const int tileM = int(gl_WorkGroupID.x) * BM, tileN = int(gl_WorkGroupID.y) * BN;
    const int tx = int(gl_LocalInvocationID.x), ty = int(gl_LocalInvocationID.y);
    const int tid = ty * 16 + tx;
    Loader la = loader(A, kAlongKA, tileM, p.m, p.lda, kTypeA, tid);
    Loader lb = loader(B, kAlongKB, tileN, p.n, p.ldb, kTypeB, tid);

    float acc[TM][TN];
    for (int i = 0; i < TM; ++i)
        for (int j = 0; j < TN; ++j) acc[i][j] = 0.0;

    uint wa[8], wb[8], va, vb;
    fetch(la, kAlongKA, kTypeA, kVecA, 0, wa, va);
    fetch(lb, kAlongKB, kTypeB, kVecB, 0, wb, vb);
    for (int k0 = 0; k0 < p.k; k0 += BK) {
        stage(true, la, kAlongKA, kTypeA, kVecA, tileM, wa, va);
        stage(false, lb, kAlongKB, kTypeB, kVecB, tileN, wb, vb);
        barrier();
        // The next step's loads, in flight during the products. Unconditional (past the last step
        // they only read the matrix's first element): a branch would make the compiler wait for
        // them where it merges.
        la.at += la.step;
        lb.at += lb.step;
        fetch(la, kAlongKA, kTypeA, kVecA, k0 + BK, wa, va);
        fetch(lb, kAlongKB, kTypeB, kVecB, k0 + BK, wb, vb);
        [[unroll]] for (int kk = 0; kk < BK; ++kk) {
            const vec4 a0 = As[kk][tx], a1 = As[kk][16 + tx], b0 = Bs[kk][ty], b1 = Bs[kk][16 + ty];
            const float a[TM] = float[TM](a0.x, a0.y, a0.z, a0.w, a1.x, a1.y, a1.z, a1.w);
            const float b[TN] = float[TN](b0.x, b0.y, b0.z, b0.w, b1.x, b1.y, b1.z, b1.w);
            for (int i = 0; i < TM; ++i)
                for (int j = 0; j < TN; ++j) acc[i][j] += a[i] * b[j];
        }
        barrier();
    }

    const uint tc = typeC();
    const uint64_t sizeC = elemSize(tc);
    // thread (tx, ty) owns rows 4 tx + {0..3} and 64 + 4 tx + {0..3}, columns likewise by ty
    for (int j = 0; j < TN; ++j) {
        const int gn = tileN + 4 * ty + (j & 3) + (j >> 2) * 64;
        if (gn >= p.n) continue;
        for (int i = 0; i < TM; ++i) {
            const int gm = tileM + 4 * tx + (i & 3) + (i >> 2) * 64;
            if (gm >= p.m) continue;
            const uint64_t at = C + (uint64_t(gm) + uint64_t(gn) * uint64_t(p.ldc)) * sizeC;
            float v = p.alpha * acc[i][j];
            if (p.beta != 0.0) v += p.beta * load1(at, tc);  // beta == 0: C may hold garbage
            if (tc == kF32) F32(canon(at)).v = v;
            else U16(canon(at)).v = uint16_t(roundToBits(v, tc == kBF16));
        }
    }
}
