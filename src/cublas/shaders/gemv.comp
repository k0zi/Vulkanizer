#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// The GEMM family's matrix-vector case (n = 1, or m = 1 by transposition):
//   y[i * incy] = alpha * sum_l M[i * rowStride + l * colStride] * v[l * incv] + beta * y[i * incy]
// for one entry of a batch (gl_WorkGroupID.z). M, v, y are f32, f16 or bf16; accumulation is f32.
// Workgroup 64 x 4. kRowMajor (M contiguous along l): 2^lanesLog2 threads stride along each row,
// 256 / 2^lanesLog2 rows per workgroup (short rows get fewer threads); otherwise 64 rows per
// workgroup with 4 slices of l each (coalesced along rows).

layout(local_size_x = 64, local_size_y = 4) in;

layout(buffer_reference, std430, buffer_reference_align = 4) buffer F32 { float v; };
layout(buffer_reference, std430, buffer_reference_align = 2) buffer U16 { uint16_t v; };
layout(buffer_reference, std430, buffer_reference_align = 8) readonly buffer Ptr { uint64_t v; };
layout(buffer_reference, std430, buffer_reference_align = 8) readonly buffer U16x4 { uvec2 v; };

// Device addresses arrive without their top bits (see vk/device.h); the hardware wants them
// canonical.
// The device's address bits 63..47 (vk::Device::addressHighBits), specialization constant 5.
layout(constant_id = 5) const uint kAddressHigh = 0xFFFF8000u;
uint64_t canon(uint64_t a) {  // on the high word alone
    uvec2 w = unpackUint2x32(a);
    w.y |= kAddressHigh;
    return packUint2x32(w);
}

layout(push_constant, std430) uniform Params {
    uint64_t m, v, y;                     // operands, or arrays of pointers (kPointerArrays)
    int64_t strideM, strideV, strideY;    // elements between batch entries
    int64_t rowStride, colStride;         // elements
    int incv, incy;
    int rows, len;
    float alpha, beta;
    uint flags;                           // types | kRowMajor | lanesLog2 << 12 | kPointerArrays
    int batchOffset;
} p;

const uint kRowMajor = 0x100u, kPointerArrays = 0x10000u;
const uint kF32 = 0u, kF16 = 1u, kBF16 = 2u;
uint typeM() { return p.flags & 3u; }
uint typeV() { return (p.flags >> 2) & 3u; }
uint typeY() { return (p.flags >> 4) & 3u; }
uint elemSize(uint t) { return t == kF32 ? 4u : 2u; }

float load(uint64_t base, int64_t index, uint type) {
    if (type == kF32) return F32(canon(base + uint64_t(index) * 4ul)).v;
    const uint bits = uint(U16(canon(base + uint64_t(index) * 2ul)).v);
    if (type == kBF16) return uintBitsToFloat(bits << 16);
    return unpackHalf2x16(bits).x;
}

uint roundToBits(float f, bool brain) {
    const uint u = floatBitsToUint(f);
    if (brain) return isnan(f) ? 0x7FC0u : (u + 0x7FFFu + ((u >> 16) & 1u)) >> 16;
    // f32 -> f16, round to nearest even
    const uint sign = (u >> 16) & 0x8000u, a = u & 0x7FFFFFFFu;
    if (a > 0x7F800000u) return sign | 0x7E00u;
    if (a >= 0x477FF000u) return sign | 0x7C00u;
    uint h;
    if (a < 0x38800000u) {  // subnormal half
        const uint e = a >> 23;
        if (e < 102u) return sign;
        const uint mant = (a & 0x7FFFFFu) | 0x800000u, s = 126u - e;
        h = mant >> s;
        const uint rem = mant & ((1u << s) - 1u), half_ = 1u << (s - 1u);
        if (rem > half_ || (rem == half_ && (h & 1u) != 0u)) ++h;
    } else {
        const uint x = a - (112u << 23);
        h = x >> 13;
        const uint rem = x & 0x1FFFu;
        if (rem > 0x1000u || (rem == 0x1000u && (h & 1u) != 0u)) ++h;
    }
    return sign | h;
}

void store(uint64_t base, int64_t index, uint type, float v) {
    if (type == kF32) F32(canon(base + uint64_t(index) * 4ul)).v = v;
    else U16(canon(base + uint64_t(index) * 2ul)).v = uint16_t(roundToBits(v, type == kBF16));
}

shared float partial[256];

void main() {
    const int batch = int(gl_WorkGroupID.z) + p.batchOffset;
    uint64_t M = p.m, V = p.v, Y = p.y;
    if ((p.flags & kPointerArrays) != 0u) {
        M = Ptr(canon(p.m + uint64_t(batch) * 8ul)).v;
        V = Ptr(canon(p.v + uint64_t(batch) * 8ul)).v;
        Y = Ptr(canon(p.y + uint64_t(batch) * 8ul)).v;
    } else {
        M += uint64_t(p.strideM * batch) * elemSize(typeM());
        V += uint64_t(p.strideV * batch) * elemSize(typeV());
        Y += uint64_t(p.strideY * batch) * elemSize(typeY());
    }
    const uint tm = typeM(), tv = typeV();
    const int lx = int(gl_LocalInvocationID.x), ly = int(gl_LocalInvocationID.y);
    const int idx = ly * 64 + lx;
    const bool rowMajor = (p.flags & kRowMajor) != 0u;
    const int lanesLog2 = int((p.flags >> 12) & 7u), lanes = 1 << lanesLog2;
    // rowMajor: `lanes` threads per row, l strided by lanes; else one row per lx, l strided by 4
    const int lane = rowMajor ? idx & (lanes - 1) : ly;
    const int row = rowMajor ? int(gl_WorkGroupID.x) * (256 >> lanesLog2) + (idx >> lanesLog2)
                             : int(gl_WorkGroupID.x) * 64 + lx;
    const int step = rowMajor ? lanes : 4;

    float sum = 0.0;
    if (row < p.rows) {
        const int64_t rowBase = int64_t(row) * p.rowStride;
        const uint64_t rowAddr = M + uint64_t(rowBase) * 2ul;
        if (rowMajor && tm == kF16 && (rowAddr & 7ul) == 0ul) {
            // 4 halves per 8-byte load; the row tail element by element
            const int vecEnd = p.len & ~3;
            for (int l = lane * 4; l < vecEnd; l += step * 4) {
                const uvec2 w = U16x4(canon(rowAddr + uint64_t(l) * 2ul)).v;
                const vec2 a01 = unpackHalf2x16(w.x), a23 = unpackHalf2x16(w.y);
                sum += a01.x * load(V, int64_t(l) * p.incv, tv) + a01.y * load(V, int64_t(l + 1) * p.incv, tv) +
                       a23.x * load(V, int64_t(l + 2) * p.incv, tv) + a23.y * load(V, int64_t(l + 3) * p.incv, tv);
            }
            for (int l = vecEnd + lane; l < p.len; l += step) sum += load(M, rowBase + l, tm) * load(V, int64_t(l) * p.incv, tv);
        } else {
            for (int l = lane; l < p.len; l += step)
                sum += load(M, rowBase + int64_t(l) * p.colStride, tm) * load(V, int64_t(l) * p.incv, tv);
        }
    }
    partial[idx] = sum;
    barrier();
    if (rowMajor) {
        for (int s = lanes >> 1; s > 0; s >>= 1) {
            if (lane < s) partial[idx] += partial[idx + s];
            barrier();
        }
    } else if (ly == 0) {
        partial[lx] = (partial[lx] + partial[64 + lx]) + (partial[128 + lx] + partial[192 + lx]);
    }
    if (lane == 0 && row < p.rows) {
        const float acc = partial[rowMajor ? idx : lx];
        const int64_t yi = int64_t(row) * p.incy;
        float r = p.alpha * acc;
        if (p.beta != 0.0) r += p.beta * load(Y, yi, typeY());
        store(Y, yi, typeY(), r);
    }
}
