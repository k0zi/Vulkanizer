#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// cuBLASLt epilogues, in place on D after the GEMM: D = act(D + bias[row]), with act ReLU or
// GELU (tanh approximation), for one entry of a batch (gl_WorkGroupID.z). D and the bias are
// f32, f16 or bf16. Workgroup 64 x 4: rows along x, columns along y.

layout(local_size_x = 64, local_size_y = 4) in;

layout(buffer_reference, std430, buffer_reference_align = 4) buffer F32 { float v; };
layout(buffer_reference, std430, buffer_reference_align = 2) buffer U16 { uint16_t v; };

layout(push_constant, std430) uniform Params {
    uint64_t d, bias;
    int64_t strideD, strideBias;  // elements between batch entries
    int rows, cols, ldd;
    uint flags;                   // typeD | typeBias << 2 | kRelu | kGelu | kBias
    int batchOffset;
} p;

const uint kRelu = 0x10u, kGelu = 0x20u, kBias = 0x40u;
const uint kF32 = 0u, kF16 = 1u, kBF16 = 2u;

float load(uint64_t base, int64_t index, uint type) {
    if (type == kF32) return F32(base + uint64_t(index) * 4ul).v;
    const uint bits = uint(U16(base + uint64_t(index) * 2ul).v);
    if (type == kBF16) return uintBitsToFloat(bits << 16);
    return unpackHalf2x16(bits).x;
}

uint roundToBits(float f, bool brain) {
    const uint u = floatBitsToUint(f);
    if (brain) return isnan(f) ? 0x7FC0u : (u + 0x7FFFu + ((u >> 16) & 1u)) >> 16;
    // f32 -> f16, round to nearest even
    const uint sign = (u >> 16) & 0x8000u, a = u & 0x7FFFFFFFu;
    if (a > 0x7F800000u) return sign | 0x7E00u;
    if (a >= 0x477FF000u) return sign | 0x7C00u;
    uint h;
    if (a < 0x38800000u) {  // subnormal half
        const uint e = a >> 23;
        if (e < 102u) return sign;
        const uint mant = (a & 0x7FFFFFu) | 0x800000u, s = 126u - e;
        h = mant >> s;
        const uint rem = mant & ((1u << s) - 1u), half_ = 1u << (s - 1u);
        if (rem > half_ || (rem == half_ && (h & 1u) != 0u)) ++h;
    } else {
        const uint x = a - (112u << 23);
        h = x >> 13;
        const uint rem = x & 0x1FFFu;
        if (rem > 0x1000u || (rem == 0x1000u && (h & 1u) != 0u)) ++h;
    }
    return sign | h;
}

void store(uint64_t base, int64_t index, uint type, float v) {
    if (type == kF32) F32(base + uint64_t(index) * 4ul).v = v;
    else U16(base + uint64_t(index) * 2ul).v = uint16_t(roundToBits(v, type == kBF16));
}

void main() {
    const int row = int(gl_GlobalInvocationID.x), col = int(gl_GlobalInvocationID.y);
    if (row >= p.rows || col >= p.cols) return;
    const int batch = int(gl_WorkGroupID.z) + p.batchOffset;
    const uint typeD = p.flags & 3u, typeBias = (p.flags >> 2) & 3u;
    const uint64_t D = p.d + uint64_t(p.strideD * batch) * (typeD == kF32 ? 4ul : 2ul);
    const int64_t index = int64_t(row) + int64_t(col) * p.ldd;
    float v = load(D, index, typeD);
    if ((p.flags & kBias) != 0u) {
        const uint64_t bias = p.bias + uint64_t(p.strideBias * batch) * (typeBias == kF32 ? 4ul : 2ul);
        v += load(bias, row, typeBias);
    }
    if ((p.flags & kRelu) != 0u) v = max(v, 0.0);
    if ((p.flags & kGelu) != 0u) {
        const float x = v;
        v = 0.5 * x * (1.0 + tanh(0.7978845608 * (x + 0.044715 * x * x * x)));
    }
    store(D, index, typeD, v);
}
