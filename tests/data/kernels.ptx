.version 7.8
.target sm_52
.address_size 64

.visible .entry saxpy(
	.param .f32 saxpy_param_0,
	.param .u64 saxpy_param_1,
	.param .u64 saxpy_param_2,
	.param .u32 saxpy_param_3
)
{
	.reg .pred 	%p<2>;
	.reg .f32 	%f<5>;
	.reg .b32 	%r<6>;
	.reg .b64 	%rd<8>;

	ld.param.f32 	%f1, [saxpy_param_0];
	ld.param.u64 	%rd1, [saxpy_param_1];
	ld.param.u64 	%rd2, [saxpy_param_2];
	ld.param.u32 	%r2, [saxpy_param_3];
	mov.u32 	%r3, %ntid.x;
	mov.u32 	%r4, %ctaid.x;
	mov.u32 	%r5, %tid.x;
	mad.lo.s32 	%r1, %r4, %r3, %r5;
	setp.ge.s32 	%p1, %r1, %r2;
	@%p1 bra 	$L__BB0_2;

	cvta.to.global.u64 	%rd3, %rd1;
	mul.wide.s32 	%rd4, %r1, 4;
	add.s64 	%rd5, %rd3, %rd4;
	ld.global.f32 	%f2, [%rd5];
	cvta.to.global.u64 	%rd6, %rd2;
	add.s64 	%rd7, %rd6, %rd4;
	ld.global.f32 	%f3, [%rd7];
	fma.rn.f32 	%f4, %f2, %f1, %f3;
	st.global.f32 	[%rd7], %f4;

$L__BB0_2:
	ret;

}

.visible .entry scaleGridStride(
	.param .u64 scaleGridStride_param_0,
	.param .u32 scaleGridStride_param_1,
	.param .f32 scaleGridStride_param_2
)
{
	.reg .pred 	%p<3>;
	.reg .f32 	%f<4>;
	.reg .b32 	%r<11>;
	.reg .b64 	%rd<5>;

	ld.param.u64 	%rd2, [scaleGridStride_param_0];
	ld.param.u32 	%r6, [scaleGridStride_param_1];
	ld.param.f32 	%f1, [scaleGridStride_param_2];
	mov.u32 	%r7, %ctaid.x;
	mov.u32 	%r1, %ntid.x;
	mov.u32 	%r8, %tid.x;
	mad.lo.s32 	%r10, %r7, %r1, %r8;
	setp.ge.s32 	%p1, %r10, %r6;
	@%p1 bra 	$L__BB1_3;

	mov.u32 	%r9, %nctaid.x;
	mul.lo.s32 	%r3, %r1, %r9;
	cvta.to.global.u64 	%rd1, %rd2;

$L__BB1_2:
	mul.wide.s32 	%rd3, %r10, 4;
	add.s64 	%rd4, %rd1, %rd3;
	ld.global.f32 	%f2, [%rd4];
	mul.f32 	%f3, %f2, %f1;
	st.global.f32 	[%rd4], %f3;
	add.s32 	%r10, %r10, %r3;
	setp.lt.s32 	%p2, %r10, %r6;
	@%p2 bra 	$L__BB1_2;

$L__BB1_3:
	ret;

}

.visible .entry index2d(
	.param .u64 index2d_param_0,
	.param .u32 index2d_param_1,
	.param .u32 index2d_param_2
)
{
	.reg .pred 	%p<4>;
	.reg .b32 	%r<15>;
	.reg .b64 	%rd<5>;

	ld.param.u64 	%rd1, [index2d_param_0];
	ld.param.u32 	%r3, [index2d_param_1];
	ld.param.u32 	%r4, [index2d_param_2];
	mov.u32 	%r5, %ctaid.x;
	mov.u32 	%r6, %ntid.x;
	mov.u32 	%r7, %tid.x;
	mad.lo.s32 	%r1, %r5, %r6, %r7;
	mov.u32 	%r8, %ntid.y;
	mov.u32 	%r9, %ctaid.y;
	mov.u32 	%r10, %tid.y;
	mad.lo.s32 	%r2, %r9, %r8, %r10;
	setp.ge.s32 	%p1, %r1, %r3;
	setp.ge.s32 	%p2, %r2, %r4;
	or.pred  	%p3, %p1, %p2;
	@%p3 bra 	$L__BB2_2;

	cvta.to.global.u64 	%rd2, %rd1;
	shl.b32 	%r11, %r2, 16;
	or.b32  	%r12, %r11, %r1;
	mad.lo.s32 	%r13, %r2, %r3, %r1;
	mul.wide.s32 	%rd3, %r13, 4;
	add.s64 	%rd4, %rd2, %rd3;
	st.global.u32 	[%rd4], %r12;

$L__BB2_2:
	ret;

}

.visible .entry intOps(
	.param .u64 intOps_param_0,
	.param .u64 intOps_param_1,
	.param .u32 intOps_param_2,
	.param .u16 intOps_param_3
)
{
	.reg .pred 	%p<3>;
	.reg .b16 	%rs<2>;
	.reg .b32 	%r<20>;
	.reg .b64 	%rd<20>;

	ld.param.u64 	%rd1, [intOps_param_0];
	ld.param.u64 	%rd2, [intOps_param_1];
	ld.param.u32 	%r2, [intOps_param_2];
	ld.param.s16 	%rs1, [intOps_param_3];
	mov.u32 	%r3, %ctaid.x;
	mov.u32 	%r4, %ntid.x;
	mov.u32 	%r5, %tid.x;
	mad.lo.s32 	%r1, %r3, %r4, %r5;
	setp.ge.s32 	%p1, %r1, %r2;
	@%p1 bra 	$L__BB3_2;

	cvta.to.global.u64 	%rd3, %rd2;
	mul.wide.s32 	%rd4, %r1, 4;
	add.s64 	%rd5, %rd3, %rd4;
	ld.global.u32 	%r6, [%rd5];
	cvta.to.global.u64 	%rd6, %rd1;
	mul.wide.s32 	%rd7, %r1, 64;
	add.s64 	%rd8, %rd6, %rd7;

	cvt.s64.s32 	%rd9, %r6;
	mul.lo.s64 	%rd10, %rd9, 3000000000;
	st.global.u64 	[%rd8], %rd10;

	div.s32 	%r7, %r6, 7;
	cvt.s64.s32 	%rd11, %r7;
	st.global.u64 	[%rd8+8], %rd11;

	rem.s32 	%r8, %r6, 7;
	cvt.s64.s32 	%rd12, %r8;
	st.global.u64 	[%rd8+16], %rd12;

	min.s32 	%r9, %r6, 100;
	cvt.s64.s32 	%rd13, %r9;
	st.global.u64 	[%rd8+24], %rd13;

	shr.s32 	%r10, %r6, 3;
	cvt.s64.s32 	%rd14, %r10;
	st.global.u64 	[%rd8+32], %rd14;

	setp.lt.s32 	%p2, %r6, 0;
	selp.b32 	%r11, 1, -1, %p2;
	cvt.s64.s32 	%rd15, %r11;
	st.global.u64 	[%rd8+40], %rd15;

	mul.hi.s32 	%r12, %r6, 1431655766;
	cvt.s64.s32 	%rd16, %r12;
	st.global.u64 	[%rd8+48], %rd16;

	shl.b32 	%r13, %r6, 4;
	shr.u32 	%r14, %r6, 28;
	or.b32  	%r15, %r13, %r14;
	shl.b32 	%r16, %r6, 40;
	add.s32 	%r17, %r15, %r16;
	cvt.s32.s16 	%r18, %rs1;
	add.s32 	%r19, %r17, %r18;
	cvt.u64.u32 	%rd17, %r19;
	st.global.u64 	[%rd8+56], %rd17;

$L__BB3_2:
	ret;

}

.visible .entry collatz(
	.param .u64 collatz_param_0,
	.param .u64 collatz_param_1,
	.param .u32 collatz_param_2
)
{
	.reg .pred 	%p<5>;
	.reg .b32 	%r<8>;
	.reg .b64 	%rd<8>;

	ld.param.u64 	%rd1, [collatz_param_0];
	ld.param.u64 	%rd2, [collatz_param_1];
	ld.param.u32 	%r2, [collatz_param_2];
	mov.u32 	%r3, %ctaid.x;
	mov.u32 	%r4, %ntid.x;
	mov.u32 	%r5, %tid.x;
	mad.lo.s32 	%r1, %r3, %r4, %r5;
	setp.ge.s32 	%p1, %r1, %r2;
	@%p1 bra 	$L__BB4_exit;

	cvta.to.global.u64 	%rd3, %rd2;
	mul.wide.s32 	%rd4, %r1, 4;
	add.s64 	%rd5, %rd3, %rd4;
	ld.global.u32 	%r5, [%rd5];
	mov.u32 	%r6, 0;

$L__BB4_loop:
	setp.eq.s32 	%p2, %r5, 1;
	@%p2 bra 	$L__BB4_done;
	setp.ge.s32 	%p3, %r6, 1000;
	@%p3 bra 	$L__BB4_done;
	and.b32  	%r7, %r5, 1;
	setp.eq.b32 	%p4, %r7, 1;
	@%p4 mad.lo.s32 	%r5, %r5, 3, 1;
	@!%p4 shr.s32 	%r5, %r5, 1;
	add.s32 	%r6, %r6, 1;
	bra.uni 	$L__BB4_loop;

$L__BB4_done:
	cvta.to.global.u64 	%rd6, %rd1;
	add.s64 	%rd7, %rd6, %rd4;
	st.global.u32 	[%rd7], %r6;

$L__BB4_exit:
	ret;

}

// for (a = 0; a < i % 5 + 1; ++a) {
//     for (b = 0; b < 10; ++b) {
//         if (b == a + 3) break;
//         if (b == 1) continue;
//         if (b == i % 11) goto end;     // leaves both loops
//         sum += b;
//     }
//     sum = sum * 3 + a;
// }
// end: out[i] = sum;
.visible .entry nested(
	.param .u64 nested_param_0,
	.param .u32 nested_param_1
)
{
	.reg .pred 	%p<7>;
	.reg .b32 	%r<12>;
	.reg .b64 	%rd<5>;

	ld.param.u64 	%rd1, [nested_param_0];
	ld.param.u32 	%r9, [nested_param_1];
	mov.u32 	%r10, %ctaid.x;
	mov.u32 	%r11, %ntid.x;
	mov.u32 	%r7, %tid.x;
	mad.lo.s32 	%r1, %r10, %r11, %r7;
	setp.ge.s32 	%p1, %r1, %r9;
	@%p1 bra 	$L__BB5_exit;

	rem.u32 	%r2, %r1, 5;
	add.s32 	%r2, %r2, 1;
	rem.u32 	%r8, %r1, 11;
	mov.u32 	%r3, 0;
	mov.u32 	%r4, 0;

$L__BB5_outer:
	setp.ge.u32 	%p2, %r3, %r2;
	@%p2 bra 	$L__BB5_end;
	mov.u32 	%r5, 0;

$L__BB5_inner:
	setp.ge.u32 	%p3, %r5, 10;
	@%p3 bra 	$L__BB5_next;
	add.s32 	%r6, %r3, 3;
	setp.eq.s32 	%p4, %r5, %r6;
	@%p4 bra 	$L__BB5_next;
	setp.eq.s32 	%p5, %r5, 1;
	@%p5 bra 	$L__BB5_inc;
	setp.eq.s32 	%p6, %r5, %r8;
	@%p6 bra 	$L__BB5_end;
	add.s32 	%r4, %r4, %r5;

$L__BB5_inc:
	add.s32 	%r5, %r5, 1;
	bra.uni 	$L__BB5_inner;

$L__BB5_next:
	mad.lo.s32 	%r4, %r4, 3, %r3;
	add.s32 	%r3, %r3, 1;
	bra.uni 	$L__BB5_outer;

$L__BB5_end:
	cvta.to.global.u64 	%rd2, %rd1;
	mul.wide.s32 	%rd3, %r1, 4;
	add.s64 	%rd4, %rd2, %rd3;
	st.global.u32 	[%rd4], %r4;

$L__BB5_exit:
	ret;

}

// out[i*8 + k], x = in[i]:
//   0 float(int(x)) (cvt.rzi saturates)  1 floor(x)  2 |x|  3 -x
//   4 min(x, 0.5)  5 max(x, -0.5)  6 x / 3  7 float(double(x) * 2)
.visible .entry floatOps(
	.param .u64 floatOps_param_0,
	.param .u64 floatOps_param_1,
	.param .u32 floatOps_param_2
)
{
	.reg .pred 	%p<2>;
	.reg .b32 	%r<7>;
	.reg .f32 	%f<12>;
	.reg .f64 	%fd<3>;
	.reg .b64 	%rd<9>;

	ld.param.u64 	%rd1, [floatOps_param_0];
	ld.param.u64 	%rd2, [floatOps_param_1];
	ld.param.u32 	%r2, [floatOps_param_2];
	mov.u32 	%r3, %ctaid.x;
	mov.u32 	%r4, %ntid.x;
	mov.u32 	%r5, %tid.x;
	mad.lo.s32 	%r1, %r3, %r4, %r5;
	setp.ge.s32 	%p1, %r1, %r2;
	@%p1 bra 	$L__BB6_2;

	cvta.to.global.u64 	%rd3, %rd2;
	mul.wide.s32 	%rd4, %r1, 4;
	add.s64 	%rd5, %rd3, %rd4;
	ld.global.f32 	%f1, [%rd5];
	cvta.to.global.u64 	%rd6, %rd1;
	mul.wide.s32 	%rd7, %r1, 32;
	add.s64 	%rd8, %rd6, %rd7;

	cvt.rzi.s32.f32 	%r6, %f1;
	cvt.rn.f32.s32 	%f2, %r6;
	st.global.f32 	[%rd8], %f2;
	cvt.rmi.f32.f32 	%f3, %f1;
	st.global.f32 	[%rd8+4], %f3;
	abs.f32 	%f4, %f1;
	st.global.f32 	[%rd8+8], %f4;
	neg.f32 	%f5, %f1;
	st.global.f32 	[%rd8+12], %f5;
	min.f32 	%f6, %f1, 0f3F000000;
	st.global.f32 	[%rd8+16], %f6;
	max.f32 	%f7, %f1, 0fBF000000;
	st.global.f32 	[%rd8+20], %f7;
	div.rn.f32 	%f8, %f1, 0f40400000;
	st.global.f32 	[%rd8+24], %f8;
	cvt.f64.f32 	%fd1, %f1;
	mul.f64 	%fd2, %fd1, 0d4000000000000000;
	cvt.rn.f32.f64 	%f9, %fd2;
	st.global.f32 	[%rd8+28], %f9;

$L__BB6_2:
	ret;

}

// out[i] = reverse(in[i] + 1), packed[i] = bits(in[i].x) | bits(in[i].y) << 32,
// swapped[i] = {bits(in[i].y), bits(in[i].x)}
.visible .entry vec4(
	.param .u64 vec4_param_0,
	.param .u64 vec4_param_1,
	.param .u64 vec4_param_2,
	.param .u64 vec4_param_3,
	.param .u32 vec4_param_4
)
{
	.reg .pred 	%p<2>;
	.reg .b32 	%r<10>;
	.reg .f32 	%f<9>;
	.reg .b64 	%rd<20>;

	ld.param.u64 	%rd1, [vec4_param_0];
	ld.param.u64 	%rd2, [vec4_param_1];
	ld.param.u64 	%rd3, [vec4_param_2];
	ld.param.u64 	%rd4, [vec4_param_3];
	ld.param.u32 	%r2, [vec4_param_4];
	mov.u32 	%r3, %ctaid.x;
	mov.u32 	%r4, %ntid.x;
	mov.u32 	%r5, %tid.x;
	mad.lo.s32 	%r1, %r3, %r4, %r5;
	setp.ge.s32 	%p1, %r1, %r2;
	@%p1 bra 	$L__BB7_2;

	cvta.to.global.u64 	%rd5, %rd4;
	mul.wide.s32 	%rd6, %r1, 16;
	add.s64 	%rd7, %rd5, %rd6;
	ld.global.v4.f32 	{%f1, %f2, %f3, %f4}, [%rd7];
	add.f32 	%f5, %f1, 0f3F800000;
	add.f32 	%f6, %f2, 0f3F800000;
	add.f32 	%f7, %f3, 0f3F800000;
	add.f32 	%f8, %f4, 0f3F800000;
	cvta.to.global.u64 	%rd8, %rd1;
	add.s64 	%rd9, %rd8, %rd6;
	st.global.v4.f32 	[%rd9], {%f8, %f7, %f6, %f5};

	mov.b32 	%r6, %f1;
	mov.b32 	%r7, %f2;
	mov.b64 	%rd10, {%r6, %r7};
	cvta.to.global.u64 	%rd11, %rd2;
	mul.wide.s32 	%rd12, %r1, 8;
	add.s64 	%rd13, %rd11, %rd12;
	st.global.u64 	[%rd13], %rd10;

	mov.b64 	{%r8, %r9}, %rd10;
	cvta.to.global.u64 	%rd14, %rd3;
	add.s64 	%rd15, %rd14, %rd12;
	st.global.v2.u32 	[%rd15], {%r9, %r8};

$L__BB7_2:
	ret;

}
