// Device-side assert(), as CUDA compilers emit it: a call of __assertfail(message, file, line,
// function, char size). check(data, n): the thread i with data[i] >= 0 asserts i < n.
.version 7.0
.target sm_75
.address_size 64

.extern .func __assertfail
(
	.param .b64 __assertfail_param_0,
	.param .b64 __assertfail_param_1,
	.param .b32 __assertfail_param_2,
	.param .b64 __assertfail_param_3,
	.param .b64 __assertfail_param_4
)
;
// "void check(int *, int)", "i < n", "assert.cu"
.global .align 1 .b8 $func[23] = {118, 111, 105, 100, 32, 99, 104, 101, 99, 107, 40, 105, 110, 116, 32, 42, 44, 32, 105, 110, 116, 41, 0};
.global .align 1 .b8 $msg[6] = {105, 32, 60, 32, 110, 0};
.global .align 1 .b8 $file[10] = {97, 115, 115, 101, 114, 116, 46, 99, 117, 0};

.visible .entry check(
	.param .u64 check_data,
	.param .u32 check_n
)
{
	.reg .pred 	%p<3>;
	.reg .b32 	%r<7>;
	.reg .b64 	%rd<12>;

	ld.param.u64 	%rd2, [check_data];
	ld.param.u32 	%r2, [check_n];
	mov.u32 	%r3, %ntid.x;
	mov.u32 	%r4, %ctaid.x;
	mov.u32 	%r5, %tid.x;
	mad.lo.s32 	%r1, %r4, %r3, %r5;
	cvta.to.global.u64 	%rd3, %rd2;
	mul.wide.s32 	%rd4, %r1, 4;
	add.s64 	%rd5, %rd3, %rd4;
	ld.global.u32 	%r6, [%rd5];
	setp.lt.s32 	%p1, %r6, 0;
	@%p1 bra 	$L_done;
	setp.lt.s32 	%p2, %r1, %r2;
	@%p2 bra 	$L_done;
	mov.u64 	%rd6, $msg;
	cvta.global.u64 	%rd7, %rd6;
	mov.u64 	%rd8, $file;
	cvta.global.u64 	%rd9, %rd8;
	mov.u64 	%rd10, $func;
	cvta.global.u64 	%rd11, %rd10;
	{
	.param .b64 param0;
	st.param.b64 	[param0+0], %rd7;
	.param .b64 param1;
	st.param.b64 	[param1+0], %rd9;
	.param .b32 param2;
	st.param.b32 	[param2+0], 42;
	.param .b64 param3;
	st.param.b64 	[param3+0], %rd11;
	.param .b64 param4;
	st.param.b64 	[param4+0], 1;
	call.uni __assertfail, (param0, param1, param2, param3, param4);
	}
$L_done:
	ret;
}
